{
  "name": "pi-voice-user",
  "version": "0.2.1",
  "description": "User-only speech input for Pi; no agent tools or prompt injection",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoungJurry/pi-voice.git"
  },
  "homepage": "https://github.com/YoungJurry/pi-voice#readme",
  "bugs": {
    "url": "https://github.com/YoungJurry/pi-voice/issues"
  },
  "files": [
    "src",
    "index.ts",
    "catalog/catalog.json",
    "catalog/recommendations.json",
    "models/silero-vad-v6.2-F32.gguf",
    "models/README.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node scripts/test-user-only.mjs && node scripts/test-cloud.mjs && node scripts/test-settings.mjs",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "jiti": "^2.6.1",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.1.0",
    "@huggingface/hub": "2.15.0",
    "opencc-js": "^1.4.1",
    "transcribe-cpp": "0.4.0"
  }
}
